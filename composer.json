{
    "name": "thewonderjoy/gaze-php",
    "description": "Framework-agnostic PHP client for Gaze, a fast debug app: gaze() helper, Ray-style fluent API, native protocol v1.",
    "type": "library",
    "license": "MIT",
    "keywords": ["debug", "dump", "ray", "gaze", "var-dumper"],
    "authors": [
        { "name": "thewonderjoy" }
    ],
    "support": {
        "issues": "https://github.com/thewonderjoy/gaze/issues",
        "source": "https://github.com/thewonderjoy/gaze/tree/main/packages/php"
    },
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "symfony/var-dumper": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "opis/json-schema": "^2.4",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "TheWonderJoy\\Gaze\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "TheWonderJoy\\Gaze\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/gaze"
    ],
    "scripts": {
        "test": "phpunit",
        "bench": "@php bench/per-call.php"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
